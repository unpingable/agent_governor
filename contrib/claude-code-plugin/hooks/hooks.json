{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(dirname \"$0\")/../scripts/posttool_receipt.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(dirname \"$0\")/../scripts/posttool_receipt.py\""
          }
        ]
      }
    ]
  }
}
