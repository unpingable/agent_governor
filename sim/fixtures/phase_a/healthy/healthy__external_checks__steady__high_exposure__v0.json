{
  "dsl_version": 1,
  "seed": 42,
  "name": "healthy__external_checks__steady__high_exposure__v0",
  "actors": ["agent"],
  "session_id": "sim-healthy-001",
  "run_id": "run-healthy-001",

  "metadata": {
    "intent": "control",
    "purpose": "Pure healthy baseline with high external verification",
    "expected_findings": [],
    "expected_non_findings": ["silent_suppression", "capture", "shear"],
    "family": "healthy",
    "mechanism": "external_checks",
    "profile": "steady",
    "exposure": "high_exposure",
    "version": 0,
    "notes": [
      "12 ticks at 500ms intervals, steady workload",
      "~75% external/tool receipts, ~10% peer, ~15% self",
      "Nonzero contradiction rate (~18%)",
      "No detector should fire"
    ]
  },

  "params": {
    "evidence_gate_strict": false
  },

  "steps": [
    {"actor": "agent", "type": "call", "t": 0,
     "payload": {"target": "gate_check", "output": "Read config file.", "task": "setup"}},
    {"type": "emit", "t": 100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "read_config",
       "evidence_bundle": {"independence_class": "tool", "source_channel": "cli"},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 500,
     "payload": {"target": "gate_check", "output": "Write user model.", "task": "feature"}},
    {"type": "emit", "t": 600,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "write_user_model",
       "evidence_bundle": {"independence_class": "external", "source_channel": "cli"},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 1000,
     "payload": {"target": "gate_check", "output": "Run pytest.", "task": "verify"}},
