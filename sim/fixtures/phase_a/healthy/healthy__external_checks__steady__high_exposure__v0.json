    {"type": "emit", "t": 4100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "warn",
       "subject_kind": "sim_event", "subject_bytes": "config_contradiction",
       "evidence_bundle": {"independence_class": "tool", "source_channel": "cli", "contradiction": true},
