       "gate": "evidence_gate", "verdict": "warn",
       "subject_kind": "sim_event", "subject_bytes": "api_contradiction",
       "evidence_bundle": {"independence_class": "tool", "source_channel": "cli", "contradiction": true},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 2000,
     "payload": {"target": "gate_check", "output": "Execute migration script.", "task": "deploy"}},
    {"type": "emit", "t": 2100,
