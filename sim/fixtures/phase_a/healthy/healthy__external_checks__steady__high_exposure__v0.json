  "asserts": [
    {"check": "expect_receipt_count", "value": 12},
    {"check": "expect_receipt_provenance_ratio",
     "independence_class": "self", "op": "lte", "value": 0.20,
     "comment": "self-receipts should be minority"},
    {"check": "expect_contradiction_count", "op": "gte", "value": 2,
     "comment": "healthy systems have nonzero contradictions"}
  ]
}
