       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "integration_test",
       "evidence_bundle": {"independence_class": "external", "source_channel": "subprocess"},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 5500,
     "payload": {"target": "gate_check", "output": "Self-check on completeness.", "task": "status"}},
    {"type": "emit", "t": 5600,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "self_completeness",
       "evidence_bundle": {"independence_class": "self", "source_channel": "cli"},
       "gate_config": {}
     }}}
