{
  "dsl_version": 1,
  "seed": 42,
  "name": "suppression__shadow_ack__step__high_exposure__v0",
  "actors": ["agent"],
  "session_id": "sim-suppression-001",
  "run_id": "run-suppression-001",

  "metadata": {
    "intent": "detector_smoke",
    "purpose": "Smoke test silent suppression: throughput flat, exposure collapses at step change",
    "expected_findings": ["silent_suppression"],
    "expected_non_findings": ["capture", "shear"],
    "family": "suppression",
    "mechanism": "shadow_ack",
    "profile": "step",
    "exposure": "high_exposure",
    "threshold_pack": "suppression_v0",
    "version": 0,
    "notes": [
      "Phase A (ticks 0-5500): healthy baseline, high external verification, nonzero contradictions",
      "Phase B (ticks 6000-11500): shadow_ack fault, self-only receipts, contradictions vanish",
      "Throughput stays flat (same proposal rate)",
      "Deliberately cartoonish step change — detector smoke test, not realism"
    ]
  },

  "params": {
    "evidence_gate_strict": false
  },

  "steps": [
    {"comment": "=== PHASE A: HEALTHY BASELINE (t=0..5500) ==="},

    {"actor": "agent", "type": "call", "t": 0,
     "payload": {"target": "gate_check", "output": "Read config file.", "task": "setup"}},
    {"type": "emit", "t": 100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "read_config",
       "evidence_bundle": {"independence_class": "tool", "source_channel": "cli"},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 1000,
     "payload": {"target": "gate_check", "output": "Write user model.", "task": "feature"}},
    {"type": "emit", "t": 1100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "write_model",
       "evidence_bundle": {"independence_class": "external", "source_channel": "cli"},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 2000,
     "payload": {"target": "gate_check", "output": "Run tests — contradicts earlier assumption.", "task": "verify"}},
    {"type": "emit", "t": 2100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "warn",
       "subject_kind": "sim_event", "subject_bytes": "test_contradiction",
       "evidence_bundle": {"independence_class": "tool", "source_channel": "subprocess", "contradiction": true},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 3000,
     "payload": {"target": "gate_check", "output": "Execute deploy script.", "task": "deploy"}},
    {"type": "emit", "t": 3100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "deploy_script",
       "evidence_bundle": {"independence_class": "tool", "source_channel": "subprocess"},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 4000,
     "payload": {"target": "gate_check", "output": "Peer review.", "task": "review"}},
    {"type": "emit", "t": 4100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "peer_review",
       "evidence_bundle": {"independence_class": "peer", "source_channel": "api"},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 5000,
     "payload": {"target": "gate_check", "output": "Lint check.", "task": "verify"}},
    {"type": "emit", "t": 5100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "lint_check",
       "evidence_bundle": {"independence_class": "external", "source_channel": "cli"},
       "gate_config": {}
     }}},


    {"comment": "=== PHASE B: SILENT SUPPRESSION (t=6000..11500) ==="},
    {"comment": "Same throughput, but receipts shift to self-only, contradictions vanish"},

    {"type": "fault", "t": 5900,
     "payload": {"flag": "shadow_ack", "value": true}},

    {"actor": "agent", "type": "call", "t": 6000,
     "payload": {"target": "gate_check", "output": "Read settings.", "task": "setup"}},
    {"type": "emit", "t": 6100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "read_settings",
       "evidence_bundle": {"independence_class": "self", "source_channel": "cli"},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 7000,
     "payload": {"target": "gate_check", "output": "Write handler.", "task": "feature"}},
    {"type": "emit", "t": 7100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "write_handler",
       "evidence_bundle": {"independence_class": "self", "source_channel": "cli"},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 8000,
     "payload": {"target": "gate_check", "output": "Verified internally.", "task": "verify"}},
    {"type": "emit", "t": 8100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "self_verify",
       "evidence_bundle": {"independence_class": "self", "source_channel": "cli"},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 9000,
     "payload": {"target": "gate_check", "output": "Deploy update.", "task": "deploy"}},
    {"type": "emit", "t": 9100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "deploy_update",
       "evidence_bundle": {"independence_class": "self", "source_channel": "cli"},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 10000,
     "payload": {"target": "gate_check", "output": "Self-reviewed.", "task": "review"}},
    {"type": "emit", "t": 10100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "self_review",
       "evidence_bundle": {"independence_class": "self", "source_channel": "cli"},
       "gate_config": {}
     }}},

    {"actor": "agent", "type": "call", "t": 11000,
     "payload": {"target": "gate_check", "output": "Self-check complete.", "task": "verify"}},
    {"type": "emit", "t": 11100,
     "payload": {"kind": "receipt", "data": {
       "gate": "evidence_gate", "verdict": "pass",
       "subject_kind": "sim_event", "subject_bytes": "self_check",
       "evidence_bundle": {"independence_class": "self", "source_channel": "cli"},
       "gate_config": {}
     }}}
  ],

  "asserts": [
    {"check": "expect_receipt_count", "value": 12,
     "comment": "same total throughput across both phases"},

    {"check": "expect_phase_receipt_count",
     "phase": "A", "tick_range": [0, 5500], "value": 6},
    {"check": "expect_phase_receipt_count",
     "phase": "B", "tick_range": [6000, 11500], "value": 6},

    {"check": "expect_receipt_provenance_ratio",
     "phase": "A", "tick_range": [0, 5500],
     "independence_class": "self", "op": "lte", "value": 0.05,
     "comment": "baseline: almost no self-receipts"},

    {"check": "expect_receipt_provenance_ratio",
     "phase": "B", "tick_range": [6000, 11500],
     "independence_class": "self", "op": "gte", "value": 0.95,
     "comment": "suppressed: almost all self-receipts"},

    {"check": "expect_contradiction_count",
     "phase": "A", "tick_range": [0, 5500],
     "op": "gte", "value": 1,
     "comment": "healthy phase has contradictions"},

    {"check": "expect_contradiction_count",
     "phase": "B", "tick_range": [6000, 11500],
     "op": "eq", "value": 0,
     "comment": "suppressed phase: zero contradictions"},

    {"check": "expect_detector",
     "detector": "silent_suppression", "fired": true,
     "comment": "this is the whole point"},

    {"check": "expect_no_detector",
     "detector": "shear",
     "comment": "no retry/error pathology here"},

    {"check": "expect_no_detector",
     "detector": "capture",
     "comment": "not claiming capture — just suppression"}
  ]
}
