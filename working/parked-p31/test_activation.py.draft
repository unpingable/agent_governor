"""Specimens for scoped activation + rollback (P3.1).

The first effect-bearing rung — a four-office transaction for exactly ONE tunable
(decomposition_size/max_slices). The negatives are load-bearing: activation must
be unreachable by a debt-clear alone, a stale/replayed/forged artifact, a forged
mode, a bare write, or any other tunable; custody must be durable; rollback must
restore topology and re-check scope.
"""

from __future__ import annotations

import json
from pathlib import Path

import pytest

from governor.activation import (
    MODE_CONSTELLATION,
    MODE_STANDALONE_DEGRADED,
    P31_RUNG,
    REFUSED_DEGRADED_CLAIMS_BACKING,
    REFUSED_INELIGIBLE,
    REFUSED_NO_ACTIVATION_RECEIPT,
    REFUSED_NO_STANDING,
    REFUSED_NOT_P31_TUNABLE,
    REFUSED_REPLAY,
    REFUSED_STALE_DIGEST,
    ActivationReceipt,
    ActivationReceiptStore,
    ActivationRefusal,
    ActiveTunableStore,
    LocalSpendLedger,
    RollbackReceipt,
    activate,
    live_claim_set_digest,
    rollback,
)
from governor.activation_preflight import RungDebt, check_activation_eligibility
from governor.annealing import AnnealingDelta, propose_delta

_HASH = "a" * 64
_KEY = "decomposition_size/max_slices"


def _delta(surface="decomposition_size", target="max_slices"):
    d = propose_delta(
        surface=surface,
        target=target,
        change_summary="lower the decomposition cap",
        baseline_id="cb_x",
        expiry="2026-06-30T00:00:00Z",
        rollback_trigger="refusal_rate>0.2",
    )
    assert isinstance(d, AnnealingDelta)
    return d


def _open_debt():
    return RungDebt(
        debt_id="d1",
        target_rung=P31_RUNG,
        authorized_collector="operator",
        discharge_witness="w",
        blocks_before="any activation",
        source_boundary_id=_HASH,
        discharged=False,
    )


def _stores(tmp_path, initial=None):
    return (
        LocalSpendLedger(tmp_path),
        ActiveTunableStore(tmp_path, initial=initial),
        ActivationReceiptStore(tmp_path),
    )


def _activate(tmp_path, *, stores=None, delta=None, **over):
    ledger, store, rstore = stores or _stores(tmp_path)
    base = dict(
        new_value=2,
        actor="operator",
        mode=MODE_STANDALONE_DEGRADED,
        spend_ledger=ledger,
        tunable_store=store,
        receipt_store=rstore,
        standing_ok=True,
        presented_claim_digest=live_claim_set_digest((), None),
        debts=(),
    )
    base.update(over)
    d = delta or _delta()
    return activate(d, **base), ledger, store, rstore


# --------------------------------------------------------------------------- #
# Happy path + modes
# --------------------------------------------------------------------------- #


class TestHappyPath:
    def test_standalone_activation_writes_and_custodies(self, tmp_path) -> None:
        res, _l, store, rstore = _activate(tmp_path)
        assert isinstance(res, ActivationReceipt)
        assert res.mode == MODE_STANDALONE_DEGRADED
        assert res.standing_basis == "bootstrap_substitute"
        assert res.custody_basis == "local_receipt_chain"
        assert res.la_spend_ref is None
        assert store.get("decomposition_size", "max_slices") == 2
        assert rstore.has(res.activation_id)  # durable custody

    def test_constellation_requires_all_three_offices(self, tmp_path) -> None:
        # standing + LA but no NQ → not four-office → refused (no faking rich).
        res, _, _, _ = _activate(
            tmp_path,
            mode=MODE_CONSTELLATION,
            external_standing_receipt="s",
            external_la_spend_ref="la",
        )
        assert isinstance(res, ActivationRefusal)
        assert res.code == REFUSED_NO_STANDING

    def test_constellation_with_all_three_carries_refs(self, tmp_path) -> None:
        res, _, _, _ = _activate(
            tmp_path,
            mode=MODE_CONSTELLATION,
            external_standing_receipt="standing_1",
            external_la_spend_ref="la_spend_1",
            external_nq_custody_ref="nq_1",
        )
        assert isinstance(res, ActivationReceipt)
        assert res.la_spend_ref == "la_spend_1"  # carried, not dropped
        assert res.nq_custody_ref == "nq_1"
        assert res.spend_ref == "la_spend_1"
        assert res.custody_basis == "constellation:nq_1"


# --------------------------------------------------------------------------- #
# The eight load-bearing negative tests
# --------------------------------------------------------------------------- #


class TestNegatives:
    def test_1_stale_disposition_blocked_by_live_claim(self, tmp_path) -> None:
        debt = _open_debt()
        res, _, store, _ = _activate(
            tmp_path,
            debts=(debt,),
            presented_claim_digest=live_claim_set_digest((debt,), None),
        )
        assert isinstance(res, ActivationRefusal)
        assert res.code == REFUSED_INELIGIBLE
        assert store.get("decomposition_size", "max_slices") is None

    def test_2_digest_mismatch_refuses(self, tmp_path) -> None:
        debt = _open_debt()
        res, _, _, _ = _activate(
            tmp_path,
            debts=(debt,),
            presented_claim_digest=live_claim_set_digest((), None),  # stale
        )
        assert isinstance(res, ActivationRefusal)
        assert res.code == REFUSED_STALE_DIGEST

    def test_3_debt_clear_alone_cannot_write(self, tmp_path) -> None:
        # Eligibility/debt-clear never touches the store, and the store has NO
        # bare write — the only writers require a receipt.
        _l, store, _r = _stores(tmp_path)
        elig = check_activation_eligibility(
            surface="decomposition_size", target="max_slices", target_rung=P31_RUNG
        )
        assert elig.eligible
        assert store.get("decomposition_size", "max_slices") is None
        assert not hasattr(ActiveTunableStore, "set")  # no bare write path

    def test_4_and_5_replay_refused_no_double_write(self, tmp_path) -> None:
        stores = _stores(tmp_path)
        delta = _delta()
        first, _, store, _ = _activate(tmp_path, stores=stores, delta=delta)
        assert isinstance(first, ActivationReceipt)
        assert store.get("decomposition_size", "max_slices") == 2
        # SAME delta object again → spend already consumed → replay, no rewrite.
        second, _, _, _ = _activate(
            tmp_path, stores=stores, delta=delta, new_value=99
        )
        assert isinstance(second, ActivationRefusal)
        assert second.code == REFUSED_REPLAY
        assert store.get("decomposition_size", "max_slices") == 2  # not 99

    def test_6_standalone_cannot_claim_external_backing(self, tmp_path) -> None:
        res, _, _, _ = _activate(
            tmp_path, external_standing_receipt="forged"
        )
        assert isinstance(res, ActivationRefusal)
        assert res.code == REFUSED_DEGRADED_CLAIMS_BACKING

    def test_7_rollback_without_receipt_refused(self, tmp_path) -> None:
        _l, store, rstore = _stores(tmp_path)
        res = rollback(
            None, reason="x", tunable_store=store, receipt_store=rstore,
            mode=MODE_STANDALONE_DEGRADED,
        )
        assert isinstance(res, ActivationRefusal)
        assert res.code == REFUSED_NO_ACTIVATION_RECEIPT

    def test_8_cannot_target_other_tunable(self, tmp_path) -> None:
        res, _, store, _ = _activate(
            tmp_path, delta=_delta(surface="routing", target="lane_weights")
        )
        assert isinstance(res, ActivationRefusal)
        assert res.code == REFUSED_NOT_P31_TUNABLE
        assert store.get("routing", "lane_weights") is None

    def test_no_standing_refused(self, tmp_path) -> None:
        res, _, _, _ = _activate(tmp_path, standing_ok=False)
        assert isinstance(res, ActivationRefusal)
        assert res.code == REFUSED_NO_STANDING


# --------------------------------------------------------------------------- #
# Rollback (scope re-check, absence topology, durable non-erasure)
# --------------------------------------------------------------------------- #


class TestRollback:
    def test_restores_prior_value(self, tmp_path) -> None:
        stores = (
            LocalSpendLedger(tmp_path),
            ActiveTunableStore(tmp_path, initial={_KEY: 3}),
            ActivationReceiptStore(tmp_path),
        )
        receipt, _, store, rstore = _activate(tmp_path, stores=stores)
        assert store.get("decomposition_size", "max_slices") == 2
        assert receipt.prior_value == 3
        rb = rollback(
            receipt, reason="trip", tunable_store=store, receipt_store=rstore,
            mode=MODE_STANDALONE_DEGRADED,
        )
        assert isinstance(rb, RollbackReceipt)
        assert store.get("decomposition_size", "max_slices") == 3
        # Activation receipt NOT erased — still in custody.
        assert rstore.has(receipt.activation_id)

    def test_rollback_to_absence_deletes_key_not_null(self, tmp_path) -> None:
        receipt, _, store, rstore = _activate(tmp_path)  # prior None → new 2
        rb = rollback(
            receipt, reason="trip", tunable_store=store, receipt_store=rstore,
            mode=MODE_STANDALONE_DEGRADED,
        )
        assert isinstance(rb, RollbackReceipt)
        assert store.get("decomposition_size", "max_slices") is None
        raw = json.loads((tmp_path / "active_tunables" / "values.json").read_text())
        assert _KEY not in raw  # absence restored, not a null value

    def test_rollback_rechecks_scope(self, tmp_path) -> None:
        # A constructed receipt for another tunable cannot drive a rollback write.
        _l, store, rstore = _stores(tmp_path)
        forged = ActivationReceipt(
            actor="x", target_rung=P31_RUNG, surface="routing",
            target="lane_weights", delta_id="d", eligibility_verdict="eligible",
            live_claim_set_digest="x", mode=MODE_STANDALONE_DEGRADED,
            standing_basis="b", spend_ref="s", la_spend_ref=None,
            nq_custody_ref=None, custody_basis="local_receipt_chain",
            prior_value=1, new_value=2,
        )
        res = rollback(
            forged, reason="x", tunable_store=store, receipt_store=rstore,
            mode=MODE_STANDALONE_DEGRADED,
        )
        assert isinstance(res, ActivationRefusal)
        assert res.code == REFUSED_NOT_P31_TUNABLE
        assert store.get("routing", "lane_weights") is None


# --------------------------------------------------------------------------- #
# Digest + fences
# --------------------------------------------------------------------------- #


class TestDigestAndFences:
    def test_digest_covers_full_content_and_parked(self, tmp_path) -> None:
        d1 = _open_debt()
        d2 = RungDebt(
            debt_id="d1", target_rung=P31_RUNG, authorized_collector="other",
            discharge_witness="w", blocks_before="b", source_boundary_id=_HASH,
        )
        # Different debt CONTENT (collector) → different digest.
        assert live_claim_set_digest((d1,)) != live_claim_set_digest((d2,))
        # Different parked set → different digest.
        assert live_claim_set_digest((d1,), frozenset()) != live_claim_set_digest(
            (d1,), frozenset({_HASH})
        )

    def test_refusal_rejects_unknown_code(self) -> None:
        with pytest.raises(ValueError, match="code must be one of"):
            ActivationRefusal(code="vibes")

    def test_la_ref_carried_never_parsed(self, tmp_path) -> None:
        import governor.activation as act

        src = Path(act.__file__).read_text()
        assert 'P31_SURFACE = "decomposition_size"' in src
        assert 'P31_TARGET = "max_slices"' in src
        # carried into the receipt, never dereferenced/parsed.
        assert "la_spend_ref=external_la_spend_ref" in src
        assert "external_la_spend_ref." not in src
